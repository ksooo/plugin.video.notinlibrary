# settings category
msgctxt "#30000"
msgid "General"
msgstr "Allgemein"

# settings label
msgctxt "#30005"
msgid "Show progress while searching"
msgstr "Fortschritt beim Suchen anzeigen"

# settings help
msgctxt "#30006"
msgid "Show a progress dialogue with the directory that is currently being examined."
msgstr "Einen Fortschrittsdialog mit dem gerade untersuchten Verzeichnis anzeigen."

# progress dialogue heading
msgctxt "#30011"
msgid "Searching for missing videos"
msgstr "Suche nach fehlenden Videos"

# dialogue heading
msgctxt "#30012"
msgid "No video sources"
msgstr "Keine Videoquellen"

# dialogue text
msgctxt "#30013"
msgid "Add video sources to Kodi first, then run this add-on again."
msgstr "Zuerst Videoquellen in Kodi hinzufügen und dieses Add-on dann erneut starten."

# notification text
msgctxt "#30014"
msgid "No missing videos found."
msgstr "Keine fehlenden Videos gefunden."

# notification heading
msgctxt "#30017"
msgid "Could not read directory"
msgstr "Verzeichnis konnte nicht gelesen werden"

# notification text
msgctxt "#30018"
msgid "Search cancelled."
msgstr "Suche abgebrochen."

# context menu entry
msgctxt "#30020"
msgid "Exclude from library import"
msgstr "Vom Bibliotheksimport ausschließen"

# context menu entry
msgctxt "#30021"
msgid "Allow library import"
msgstr "Bibliotheksimport erlauben"

# top level entry and heading
msgctxt "#30022"
msgid "Excluded"
msgstr "Ausgeschlossen"

# notification text
msgctxt "#30023"
msgid "No videos are excluded from library import."
msgstr "Es sind keine Videos vom Bibliotheksimport ausgeschlossen."

# notification text
msgctxt "#30024"
msgid "Could not save the list of excluded videos."
msgstr "Die Liste der ausgeschlossenen Videos konnte nicht gespeichert werden."

# top level entry and heading
msgctxt "#30026"
msgid "Missing"
msgstr "Fehlend"

# notification text
msgctxt "#30027"
msgid "Could not undo the exclusion."
msgstr "Der Ausschluss konnte nicht aufgehoben werden."
